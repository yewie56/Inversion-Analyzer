{
  "archive_dir": "archive",
  "auto_fetch_missing": true,
  "remote_archive": {
    "enabled": true,
    "provider": "github_raw",
    "owner": "yewie56",
    "repository": "Inversion-Analyzer",
    "branch": "main",
    "archive_path": "archive"
  },
  "github_actions": {
    "daily_fetch_local_hour": 22,
    "retry_delay_hours": 3,
    "max_retries": 5,
    "retry_only_missing": true,
    "completion_sources": [
      "dwd",
      "profile",
      "icon_d2"
    ],
    "optional_sources": [
      "sonde",
      "kit_mast"
    ],
    "retry_optional_sources": false,
    "kit_continuous_archive": true,
    "kit_coverage_min_profiles_for_cadence": 3,
    "kit_complete_gap_factor": 1.5
  }
}
